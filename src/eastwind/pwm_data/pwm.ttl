pwm:CommunicationError a skos:Concept ; skos:notation "communication_error" ; skos:inScheme pwm:InteractionOutcomeKindScheme ; skos:prefLabel "communication error"@en ; skos:definition "A delivered communication contains incorrect or misleading content."@en ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 15" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialized record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(d): incidents and near misses; 5.23(b)" ] .
pwm:PolicyBreach a skos:Concept ; skos:notation "policy_breach" ; skos:inScheme pwm:InteractionOutcomeKindScheme ; skos:prefLabel "policy breach"@en ; skos:definition "An action or output violates an applicable policy rule."@en ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 15" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialized record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(d): incidents and near misses; 5.23(b)" ] .
pwm:OperationalIncident a skos:Concept ; skos:notation "operational_incident" ; skos:inScheme pwm:InteractionOutcomeKindScheme ; skos:prefLabel "operational incident"@en ; skos:definition "An operational failure disrupts the interaction or its controls."@en ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 15" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialized record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(d): incidents and near misses; 5.23(b)" ] .
