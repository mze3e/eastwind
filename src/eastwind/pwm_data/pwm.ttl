# =============================================================================
#  PWM 0.8: Trust, resilience and assurance (module 12)
#
#  Signed evidence and keys, anchors, recovery, the model-provider register,
#  failover and model change, the dependency map, failure drills, retention by
#  record class, incident reports, and runtime assurance records. Follows
#  Kognita milestones 0.7 (Trust and Resilience) and 0.8 (Supervisory Alignment
#  and Runtime Assurance), and fills the vocabulary gaps found in the 0.5 review.
#  Generated from tools/gen_module12.py; edit that script, not this file.
# =============================================================================

pwm:ModuleTrust a pwm:Module ; rdfs:label "Trust, resilience and assurance"@en ; pwm:moduleOrder 12 ;
    skos:definition "Signed and anchored evidence, provider and dependency registers, failover and drills, retention by record class, incident reports and runtime assurance records."@en .

pwm:SigningKey a owl:Class ; rdfs:label "signing key"@en ;
    skos:definition "Public identity of an evidence-signing key: key identifier, public key reference and escrow reference. Holds no private key material."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleTrust ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.7 item T1 (Ed25519 signing)" ], [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.7 item R2 (key rotation, revocation and escrow)" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.8: NEW specialized record or property; no exact standard term identified" ] .

pwm:KeyRotation a owl:Class ; rdfs:label "key rotation"@en ;
    skos:definition "Record that one signing key replaced another. Verification works across rotations."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleTrust ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.7 item R2 (key rotation, revocation and escrow)" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.8: NEW specialized record or property; no exact standard term identified" ] .

pwm:KeyRevocation a owl:Class ; rdfs:label "key revocation"@en ;
    skos:definition "Record that a signing key is revoked from a stated evidence sequence. Signatures at or after that sequence fail closed."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleTrust ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.7 item R2 (key rotation, revocation and escrow)" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.8: NEW specialized record or property; no exact standard term identified" ] .

pwm:EvidenceAnchor a owl:Class ; rdfs:label "evidence anchor"@en ;
    skos:definition "Checkpoint of the chain head (record hash and sequence) published to a store the firm does not control, so a rewrite of the anchored prefix is detectable."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleTrust ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.7 item T6 (external anchoring)" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.8: NEW specialized record or property; no exact standard term identified" ] .

pwm:RecoveryBundle a owl:Class ; rdfs:label "recovery bundle"@en ;
    skos:definition "Backup of the evidence chain, retained content, holds, retention policies, key registry and anchors, recoverable to a sequence or time and verified before publication."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleTrust ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C1 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.7 item R1 (backup and restore)" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.8: NEW specialized record or property; no exact standard term identified" ] .

pwm:ExternalReviewSubmission a owl:Class ; rdfs:label "external review submission"@en ;
    skos:definition "Signed review by an external reviewer of an immutable range of evidence sequences, with annotations. The reviewer signature is checked against the key registry."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleTrust ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.7 item T3 (external review API)" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.8: NEW specialized record or property; no exact standard term identified" ] .

