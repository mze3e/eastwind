pwm:PolicyPack a owl:Class ; rdfs:label "policy pack"@en ;
    skos:definition "Named versioned bundle of policy artifacts, scenarios and fixture references; a private overlay may shadow a built-in pack."@en ; rdfs:subClassOf prov:Entity ;
    pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C1 ;
