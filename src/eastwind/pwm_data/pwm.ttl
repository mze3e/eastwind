pwm:ModuleBusiness a pwm:Module ; rdfs:label "Business scope"@en ; pwm:moduleOrder 13 ;
    skos:definition "Costs and charges, product governance, client circumstances, orders and executions, corporate actions and income, tax reporting, lending and performance provenance."@en .

pwm:CostDisclosure a owl:Class ; rdfs:label "cost disclosure"@en ;
    skos:definition "Disclosure to a client of the costs and charges of an investment service or product, ex ante before the service and ex post after the period, with the total and its items."@en ; rdfs:subClassOf prov:Entity ;
