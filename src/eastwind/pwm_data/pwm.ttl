pwm:BlockedAction a skos:Concept ; skos:notation "blocked_action" ; skos:inScheme pwm:NearMissKindScheme ; skos:prefLabel "blocked action"@en ; skos:definition "A control prevents a potentially harmful action from executing."@en ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 15" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialized record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(d): incidents and near misses; 5.23(b)" ] .
pwm:VerifierBlock a skos:Concept ; skos:notation "verifier_block" ; skos:inScheme pwm:NearMissKindScheme ; skos:prefLabel "verifier block"@en ; skos:definition "A verifier rejects an output before it proceeds."@en ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 15" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialized record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(d): incidents and near misses; 5.23(b)" ] .
pwm:RMRejection a skos:Concept ; skos:notation "rm_rejection" ; skos:inScheme pwm:NearMissKindScheme ; skos:prefLabel "RM rejection"@en ; skos:definition "A relationship manager rejects an AI draft or proposed action."@en ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 15" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialized record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(d): incidents and near misses; 5.23(b)" ] .
pwm:UnsafeDraft a skos:Concept ; skos:notation "unsafe_draft" ; skos:inScheme pwm:NearMissKindScheme ; skos:prefLabel "unsafe draft"@en ; skos:definition "A potentially harmful draft is identified before delivery."@en ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 15" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialized record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(d): incidents and near misses; 5.23(b)" ] .
pwm:UnusualAgentBehavior a skos:Concept ; skos:notation "unusual_agent_behavior" ; skos:inScheme pwm:NearMissKindScheme ; skos:prefLabel "unusual agent behavior"@en ; skos:definition "Unexpected agent behavior is detected before harm occurs."@en ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 15" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialized record or field; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9(d): incidents and near misses; 5.23(b)" ] .

pwm:implicatedModel a owl:ObjectProperty ; rdfs:label "implicated model"@en ; skos:definition "Pinned model implicated in an outcome or near miss, without asserting that the outcome is itself a model call."@en ; rdfs:range pwm:AIModel ; pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 15" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "NEW specialized link" ] .

pwm:evaluatedAgainstAppetite a owl:ObjectProperty ;
    rdfs:label "evaluated against appetite"@en ;
    skos:definition "Versioned institutional appetite against which registration and residual materiality were evaluated."@en ;
    rdfs:range pwm:AIRiskAppetite ; pwm:inModule pwm:ModuleLifecycle ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 8: risk appetite" ],
                 [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "4.11: residual materiality" ],
                 [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "NEW specialized evaluation link" ] .

pwm:exportLocator a owl:DatatypeProperty ; rdfs:label "export locator"@en ; skos:definition "Retrieval location of the recorder export manifest."@en ; rdfs:domain pwm:FlightRecorderSession ; rdfs:range xsd:anyURI ; pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 7" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialized record or field; no exact standard term identified" ] .

pwm:diffLocator a owl:DatatypeProperty ; rdfs:label "diff locator"@en ; skos:definition "Retrieval location of the structured edit diff; retention is established separately."@en ; rdfs:domain pwm:RMReviewEdit ; rdfs:range xsd:anyURI ; pwm:inModule pwm:ModuleLifecycle ; pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "0.4 item 11" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.4: NEW specialized record or field; no exact standard term identified" ] .

# PWM 0.5: Agents, Authority and Fleets

pwm:ModuleAgents a pwm:Module ; rdfs:label "Agents, authority and fleets"@en ; pwm:moduleOrder 11 ;
    skos:definition "Workload identities, scoped human authority, autonomy evidence, containment and fleet controls."@en .

pwm:WorkloadIdentity a owl:Class ; rdfs:label "workload identity"@en ;
    skos:definition "Registry of an individual agent workload credential reference, issuer, subject and environment. Stores no private key or token. Gateways verify possession on every call."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 1" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "1.11 agent risks; fn 25 agent identifiers and components" ] .

pwm:AuthorityScope a owl:Class ; rdfs:label "authority scope"@en ;
    skos:definition "Explicit finite sets of clients, purposes, verbs, tools, fields, systems, products and jurisdictions. Omission grants nothing for dimensions checked by the written narrowing rules. Numeric caps and autonomy may only narrow."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ] .

pwm:HumanEntitlement a owl:Class ; rdfs:label "human entitlement"@en ;
    skos:definition "Time-bounded entitlement held by a named person, with explicit subject scope. An agent delegation cannot enlarge this scope."@en ; rdfs:subClassOf cmns-bauth:Authorization ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ] .

pwm:AuthorityRevocation a owl:Class ; rdfs:label "authority revocation"@en ;
    skos:definition "Record that authority or a credential was revoked at a stated time, including task completion. Revocation is effective on the next decision."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 2" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ] .

pwm:AutonomyTransition a owl:Class ; rdfs:label "autonomy transition"@en ;
    skos:definition "Evidenced promotion or automatic one-level step-down for an agent, with before and after levels, evaluation window, metric sample, approval and notification records. Restoration requires promotion again."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 3" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ], [ pwm:cites pwmref:EVOLVE ; pwm:locator "Stage 4: quality metrics before more autonomy" ], [ pwm:cites pwmref:AM-GOVERNING-AGENTIC-AI ; pwm:locator "Section 04: autonomy is a license, not a launch setting" ], [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.9 human oversight" ] .

pwm:BlastRadiusLimit a owl:Class ; rdfs:label "blast radius limit"@en ;
    skos:definition "Agent-wide damage limits independent of RunBudget. Each limit names a dimension, unit, aggregation basis, time window and maximum. Decisions carry projected consumption including the proposed action."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 4" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ] .

pwm:BlastRadiusObservation a owl:Class ; rdfs:label "blast radius observation"@en ;
    skos:definition "Recorded projected cumulative consumption against one agent limit, including the requested action. Window and dimension are inherited from that exact limit."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 4" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ] .

pwm:ExternalContent a owl:Class ; rdfs:label "external content"@en ;
    skos:definition "Content from outside the institution, including agent messages, PDFs and API responses. Its trust label never conveys instruction authority."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 6" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ] .

pwm:AuthenticatedInstruction a owl:Class ; rdfs:label "authenticated instruction"@en ;
    skos:definition "Instruction with authenticated human, assurance level, source and transaction context. A signature reference is evidence to verify, never a secret or a substitute for step-up authorization."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 7" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ] .

pwm:BehaviorBaseline a owl:Class ; rdfs:label "behavior baseline"@en ;
    skos:definition "Versioned per-agent expected behavior and containment threshold for a named metric over a window."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 8" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ] .

pwm:BehaviorAnomaly a owl:Class ; rdfs:label "behavior anomaly"@en ;
    skos:definition "Observed deviation from an agent baseline, with automatic containment and incident links. Human release follows containment."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 8" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ] .

pwm:CapabilityGrant a owl:Class ; rdfs:label "capability grant"@en ;
    skos:definition "Explicit expiring and revocable capability assigned to an agent within a subject scope. Issue, use, expiry and revocation are evidenced."@en ; rdfs:subClassOf cmns-bauth:Authorization ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 10" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ] .

pwm:AgentFleet a owl:Class ; rdfs:label "agent fleet"@en ;
    skos:definition "Registered group of agents under common quotas, isolation and halt controls. External members are untrusted principals."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 11" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ] .

pwm:FleetHalt a owl:Class ; rdfs:label "fleet halt"@en ;
    skos:definition "Recorded fleet-wide stop instruction with explicit fleet scope and time. Runtime dispatch and cancellation are performed by the gateway."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 11" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ] .

pwm:SandboxConstraints a owl:Class ; rdfs:label "sandbox constraints"@en ;
    skos:definition "Decision output specifying the permitted credential references, network destinations, filesystem scope, APIs, commands, export, persistence, auto-stop interval and resource caps. Kognita emits constraints, not a sandbox."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleAgents ; pwm:contextSpeed pwm:MediumContext ; pwm:defaultClassification pwm:C2 ;
    pwm:citation [ pwm:cites pwmref:KOG-ROADMAP ; pwm:locator "roadmap milestone 0.5 item 12" ], [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.5: NEW specialized record or property; no exact standard term identified" ] .

pwm:CompensatingAction a owl:Class ; rdfs:label "compensating action"@en ;
    skos:definition "Registered recovery action for a reversible tool; recovery records reference the original call and an explicit reverse execution order."@en ; rdfs:subClassOf prov:Entity ;
