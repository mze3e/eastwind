# Deprecated terms. Before 1.0 a release can rename terms; each renamed IRI stays declared
# with owl:deprecated for one version and names its replacement (ROADMAP.md, versioning policy).
#
# 0.10 removed the aliases that 0.8 introduced for the US spelling renames (AuthorisedSignatory,
# BehaviourAnomaly, BehaviourBaseline, BookingCentre, bookingCentreCode, CommContextualisedInsight,
# InternationalOrganisationPEP, UnusualAgentBehaviour, VerbAnalyse, PossibleProviderCapability).
# Remove the declarations below in 0.11.

owl:deprecated a owl:AnnotationProperty .
dcterms:isReplacedBy a owl:AnnotationProperty .

# xsd:duration is outside the OWL 2 datatype map, so the replacement counts whole seconds.
# The old property has no range, so it brings no non-OWL 2 datatype back.
pwm:freshnessThreshold a owl:DatatypeProperty ; rdfs:label "freshness threshold (deprecated)"@en ;
    skos:definition "Deprecated: an xsd:duration. Use pwm:freshnessThresholdSeconds, for example P1D becomes 86400."@en ;
    owl:deprecated true ; dcterms:isReplacedBy pwm:freshnessThresholdSeconds ;
    pwm:inModule pwm:ModuleCore ; pwm:citation [ pwm:cites pwmref:PWM-PRACTICE ; pwm:locator "0.10 datatype migration; deprecated alias for one version" ] .
# Reasoning axioms (0.8). The data rules in SHACL stay the authority on recorded structure;
# these axioms let an OWL reasoner find contradictions without the shapes. Each axiom
# is stated only where the model already treats the situation as an error. HermiT and the
# example check in tests/test_axioms.py keep them honest.
#
# Inverse properties are deliberately not declared: no consumer reads the inverse
# direction yet, and an unpopulated term is a cost (ROADMAP.md, risks).

# A mandate belongs to exactly one service type.
[] a owl:AllDisjointClasses ;
    owl:members ( pwm:AdvisoryMandate pwm:DiscretionaryMandate pwm:ExecutionOnlyArrangement pwm:CustodyOnlyArrangement ) .

# An agent is not a model, a use case, an AI system or a model provider.
[] a owl:AllDisjointClasses ;
    owl:members ( pwm:AIAgent pwm:AIModel pwm:AIUseCase pwm:AISystem pwm:ModelProvider ) .

# An AI agent is not a natural person. Accountability roles already refuse an agent.
pwm:AIAgent owl:disjointWith fibo-fnd-aap-ppl:Person .

# Single-valued record fields.
pwm:recordHash a owl:FunctionalProperty .
pwm:previousRecordHash a owl:FunctionalProperty .
pwm:eventType a owl:FunctionalProperty .
pwm:signature a owl:FunctionalProperty .
pwm:evidenceSequence a owl:FunctionalProperty .
pwm:schemaVersion a owl:FunctionalProperty .
pwm:keyId a owl:FunctionalProperty .
pwm:anchoredRecordHash a owl:FunctionalProperty .
pwm:anchoredSequence a owl:FunctionalProperty .
pwm:bundleHash a owl:FunctionalProperty .
pwm:manifestDigest a owl:FunctionalProperty .
pwm:traceHash a owl:FunctionalProperty .
pwm:outcomeId a owl:FunctionalProperty .
pwm:effectiveFromSequence a owl:FunctionalProperty .
# Additional MAS AIRG citations, added in 0.10 while mapping every paragraph in the MAS table of
# docs/control-frameworks.md (AIRG_MAP.md). Each says where an existing term is the data for a paragraph.
# They are instrument-level, like the register entry they cite.

pwm:AccountabilityRole pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "2.5(a): a senior manager accountable for AI oversight" ] .
pwm:AIUseCase pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "2.5(b): permitted and prohibited uses are the use-case register's lifecycle status; 2.5(c): approved AI and an approval process for new use" ] .
pwm:HumanReview pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "2.5(b): mandatory human review before use" ] .
pwm:AISystem pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "2.5(c): approved list of AI systems and tools" ] .
pwm:RiskMaterialityAssessment pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "2.5(e) and 2.5(f): periodic and trigger-based review of materiality" ] .
pwm:ReviewCoverageReport pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "3.6: local senior management visibility, reports filterable by jurisdiction" ] .
pwm:FairnessReport pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.7 and 5.8: fair outcomes; fairness assessments on protected attributes and proxies" ] .
pwm:FailureDrill pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.15: guardrails tested for agent failure modes; 5.22: technology and cybersecurity review, red teaming" ] .
pwm:AdversarialTestCase pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.15: guardrails tested for agent failure modes; 5.22: red teaming" ] .
pwm:BehaviorAnomaly pwm:citation [ pwm:cites pwmref:MAS-AIRG ; pwm:locator "5.22: anomaly detection" ] .
