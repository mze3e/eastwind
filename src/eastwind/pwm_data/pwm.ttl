    skos:definition "A model provider recorded as an ICT third party: use cases that depend on it, data residency and retention, training use, sub-processors, encryption, incident notification, availability, model-change notice, audit rights, exit plan, incident history and regulatory cooperation."@en ; rdfs:subClassOf prov:Entity ;
    pwm:inModule pwm:ModuleTrust ; pwm:contextSpeed pwm:SlowContext ; pwm:defaultClassification pwm:C1 ;
