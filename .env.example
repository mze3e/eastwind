# Copy to .env locally; never commit credentials.
# Choices: mock, openai, anthropic, xai, ollama, openai-compatible.
EASTWIND_LLM_PROVIDER=mock
# Leave blank to use the provider preset; compatible endpoints require a model.
EASTWIND_LLM_MODEL=
# The local origin of kognita serve, without /v1.
EASTWIND_LLM_GATEWAY_URL=
# SQLite store passed to kognita serve; keep separate from the scenario store.
EASTWIND_LLM_GATEWAY_DB=
# Provider origin for configuring kognita serve; Eastwind never calls it directly.
# Presets: https://api.openai.com, https://api.x.ai, http://127.0.0.1:11434.
# Use your own origin for vLLM, LM Studio, Groq, Together, or Mistral.
EASTWIND_LLM_BASE_URL=
# Optional override: name of the environment variable containing the provider key.
# Defaults: OPENAI_API_KEY, ANTHROPIC_API_KEY, XAI_API_KEY, EASTWIND_LLM_API_KEY.
EASTWIND_LLM_KEY_ENV=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
EASTWIND_LLM_API_KEY=
# Anthropic bridge credential, at least 32 characters, shared only with the gateway.
EASTWIND_ANTHROPIC_BRIDGE_TOKEN=
OPENAI_MODEL=gpt-4o-mini
