# Copy to .env locally; never commit credentials.
EASTWIND_LLM_PROVIDER=mock
EASTWIND_LLM_MODEL=eastwind-mock
# Origin of the configured Kognita gateway, for example http://127.0.0.1:8080
EASTWIND_LLM_GATEWAY_URL=
# Provider origin is configured on kognita serve, not on the client.
EASTWIND_LLM_BASE_URL=
# Name of the variable holding the provider key in the gateway environment.
EASTWIND_LLM_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
EASTWIND_LLM_API_KEY=
OPENAI_MODEL=gpt-4o-mini
